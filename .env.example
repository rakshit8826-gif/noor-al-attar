# ── WhatsApp ────────────────────────────────────────────
NEXT_PUBLIC_WHATSAPP_NUMBER=918826838804      # country code + number, no plus/spaces
NEXT_PUBLIC_WHATSAPP_DEFAULT_MESSAGE=Assalamu Alaikum! I have a question about Noor Al Attar attars.

# ── Admin (REQUIRED in production) ──────────────────────
ADMIN_PASSWORD=change-me-strong-password
JWT_SECRET=random-32-char-secret-change-me-please

# ── Persistence (needed for live admin edits on Vercel) ─
# Vercel → Storage → Create KV/Upstash Redis → these are added automatically
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: image uploads from the admin panel (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# ── Analytics (optional) ────────────────────────────────
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Email (optional; contact form falls back to WhatsApp) ─
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# ── Site ────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nooralattar.in
NEXT_PUBLIC_SITE_NAME=Noor Al Attar
NEXT_PUBLIC_GSTIN=29XXXXXXXXXXXZX
NEXT_PUBLIC_FREE_SHIPPING_THRESHOLD=1499
NEXT_PUBLIC_FLAT_SHIPPING=79
